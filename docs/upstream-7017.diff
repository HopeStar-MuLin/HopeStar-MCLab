diff --git a/HMCL/src/main/java/org/jackhuang/hmcl/util/RegionUtils.java b/HMCL/src/main/java/org/jackhuang/hmcl/util/RegionUtils.java
new file mode 100644
index 00000000000..00f6c14750e
--- /dev/null
+++ b/HMCL/src/main/java/org/jackhuang/hmcl/util/RegionUtils.java
@@ -0,0 +1,116 @@
+/*
+ * Hello Minecraft! Launcher
+ * Copyright (C) 2026 huangyuhui <huanghongxun2008@126.com> and contributors
